+class _SnapshotClickNavigation:
+    """Wait for a main-document request observed during a DOM click and its grace.
+
+    A response and frame commit must precede DCL: an already-ready old document
+    cannot satisfy this barrier. Same-document navigation has no document request.
+    This does not promise readiness of asynchronous application initialization.
+    """
+
+    def __init__(self, page: Any, timeout: int) -> None:
+        self.page = page
+        self.deadline = time.monotonic() + timeout / 1000
+        self.request: Any = None
+        self.response_received = False
+        self.committed = False
+        self.ready = False
+        self.failure: str | None = None
+        self.listeners = {
+            "request": self._request,
+            "response": self._response,
+            "framenavigated": self._committed,
+            "domcontentloaded": self._ready,
+            "requestfailed": self._failed,
+        }
+        for event, listener in self.listeners.items():
+            page.on(event, listener)
+
+    def _request(self, request: Any) -> None:
+        if request.is_navigation_request() and request.frame == self.page.main_frame:
+            self.request = request
+            self.response_received = self.committed = self.ready = False
+            self.failure = None
+
+    def _response(self, response: Any) -> None:
+        redirects = response.status in {301, 302, 303, 307, 308} and (
+            "location" in response.headers
+        )
+        if response.request == self.request and not redirects:
+            self.response_received = True
+
+    def _committed(self, frame: Any) -> None:
+        if frame == self.page.main_frame and self.response_received:
+            self.committed = True
+
+    def _ready(self, *_: Any) -> None:
+        if self.committed:
+            self.ready = True
+
+    def _failed(self, request: Any) -> None:
+        if request == self.request:
+            self.failure = request.failure or "document navigation failed"
+
+    def wait(self) -> None:
+        while self.request is not None:
+            if self.failure:
+                raise RuntimeError(self.failure)
+            if self.ready:
+                return
+            remaining = (self.deadline - time.monotonic()) * 1000
+            if remaining <= 0:
+                raise TimeoutError(
+                    "Click navigation did not reach its new document's DOMContentLoaded"
+                )
+            # Pump Playwright events, bounded by the same action deadline.
+            self.page.wait_for_timeout(min(50, remaining))
+
+    def close(self) -> None:
+        for event, listener in self.listeners.items():
+            self.page.remove_listener(event, listener)
+
+
